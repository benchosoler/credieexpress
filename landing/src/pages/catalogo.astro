---
import Layout from '../layouts/Layout.astro';
import NavbarCatalogo from '../components/NavbarCatalogo.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Catalogo from '../components/Catalogo.astro';
---

<Layout
  title="Catálogo Completo | CREDIEXPRESS - Equipamiento para comercios"
  description="Explorá nuestro catálogo completo: balanzas, heladeras, freezers, estanterías y más. Filtrá por categoría y subcategoría para encontrar lo que necesitás para tu comercio."
>
  <NavbarCatalogo />

  <main class="pt-20">
    <!-- Page header -->
    <section class="bg-gradient-to-br from-gris-claro to-blue-50 py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto animate-on-scroll">
          <span class="inline-block bg-azul/10 text-azul px-4 py-1.5 rounded-full text-sm font-semibold mb-4">
            Catálogo completo
          </span>
          <h1 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
            Todos nuestros productos
          </h1>
          <p class="text-lg text-gray-600">
            Explorá nuestro catálogo por categoría y subcategoría. Consultá por WhatsApp para armar tu plan de financiación.
          </p>
        </div>
      </div>
    </section>

    <!-- Catalog section — all rendering, filtering, and error handling lives in Catalogo.astro -->
    <Catalogo />
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
