---
import RevistaLayout from "../layouts/RevistaLayout.astro";
import { fetchTodosProductos, fetchCategorias } from "../lib/strapi";

import type { ProductoStrapi } from "../lib/strapi-types";

let productos: ProductoStrapi[] = [];
let categorias: string[] = [];

try {
  const [prodRes, catRes] = await Promise.all([
    fetchTodosProductos(),
    fetchCategorias()
  ]);
  productos = prodRes || [];
  categorias = catRes || [];
} catch (error) {
  console.warn('[Revista] No se pudo conectar a Strapi:', error);
}
---

<RevistaLayout productos={productos} categorias={categorias} />
