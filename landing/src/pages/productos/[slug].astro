---
import type { ProductoStrapi } from "../../lib/strapi-types";
import {
  fetchTodosProductos,
  fetchProductoBySlug,
  getProductosBySubcategoria,
  getWhatsAppLink,
  formatPrecio,
  renderBlocks,
} from "../../lib/strapi";
import Layout from "../../layouts/Layout.astro";
import NavbarCatalogo from "../../components/NavbarCatalogo.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import ProductCard from "../../components/ProductCard.astro";

export async function getStaticPaths() {
  try {
    const productos = await fetchTodosProductos();
    return productos
      .filter((p: ProductoStrapi) => p.slug && p.slug.length > 0)
      .map((p: ProductoStrapi) => ({ params: { slug: p.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
const producto = await fetchProductoBySlug(slug);

// Product not found → redirect to catalog
if (!producto) {
  return Astro.redirect("/catalogo");
}

const waLink = getWhatsAppLink(producto);
const precio = formatPrecio(producto.precio);

// --- Build images array for gallery ---
const images = (producto.imagenes && producto.imagenes.length > 0)
  ? producto.imagenes
  : (producto.imagen
      ? [producto.imagen]
      : (producto.imagenUrl ? [{ url: producto.imagenUrl } as any] : []));

// --- Breadcrumb ---
const primarySub = producto.subcategorias?.[0];

// --- Ficha técnica ---
const fichaHtml = producto.fichaTecnica
  ? renderBlocks(JSON.parse(producto.fichaTecnica))
  : null;

// --- Related products ---
let relacionados: ProductoStrapi[] = [];
if (primarySub) {
  try {
    const siblings = await getProductosBySubcategoria(primarySub.slug, 5);
    relacionados = siblings
      .filter((p) => p.documentId !== producto.documentId)
      .slice(0, 4);
  } catch {
    relacionados = [];
  }
}

// Page title + description
const pageTitle = `${producto.nombre} | CREDIEXPRESS - Equipamiento para comercios`;
const pageDescription = producto.descripcion
  ? producto.descripcion.slice(0, 160)
  : `${producto.nombre} — Equipamiento comercial con financiación flexible. Consultá por WhatsApp.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <NavbarCatalogo />

  <main class="pt-20">
    <!-- Breadcrumb -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500">
        <li>
          <a href="/" class="hover:text-azul transition-colors">Inicio</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href="/catalogo" class="hover:text-azul transition-colors">Catálogo</a>
        </li>
        {primarySub && (
          <>
            <li aria-hidden="true">›</li>
            <li>
              <span class="text-gray-400">{primarySub.nombre}</span>
            </li>
          </>
        )}
        <li aria-hidden="true">›</li>
        <li>
          <span class="text-gray-900 font-medium truncate max-w-[200px] sm:max-w-xs inline-block align-bottom">
            {producto.nombre}
          </span>
        </li>
      </ol>
    </nav>

    <!-- Product detail: two-column layout -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <!-- Left column: Gallery (sticky on desktop) -->
        <div class="md:sticky md:top-24 self-start">
          <div class="relative aspect-[4/3] bg-gris-claro rounded-2xl overflow-hidden">
            <ProductGallery
              images={images}
              alt={producto.nombre}
              priority={true}
              max={images.length}
            />
          </div>
          {producto.destacado && (
            <div class="absolute top-3 right-3 bg-verde text-white px-3 py-1 rounded-full text-xs font-semibold shadow-sm z-10">
              Destacado
            </div>
          )}
        </div>

        <!-- Right column: Product info -->
        <div class="flex flex-col gap-6">
          <!-- Category badge -->
          {primarySub && (
            <span class="self-start inline-block bg-azul/10 text-azul px-4 py-1.5 rounded-full text-sm font-semibold">
              {primarySub.nombre}
            </span>
          )}

          <!-- Product name -->
          <h1 class="font-display text-3xl sm:text-4xl font-bold text-gray-900 leading-tight">
            {producto.nombre}
          </h1>

          <!-- Price -->
          <div class={`text-2xl sm:text-3xl font-bold ${
            producto.precio ? "text-azul" : "text-gray-400"
          }`}>
            {precio}
          </div>

          <!-- WhatsApp CTA -->
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full sm:w-auto sm:self-start bg-verde text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-verde-dark transition-all duration-200 hover:shadow-lg hover:shadow-verde/20"
            aria-label={`Consultar por WhatsApp: ${producto.nombre}`}
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
            </svg>
            Consultar precio y cuotas
          </a>
        </div>
      </div>
    </section>

    <!-- Description — full-width dedicated section -->
    {producto.descripcion && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
        <div class="border-t border-gray-200 pt-10">
          <h2 class="font-display text-2xl font-bold text-gray-900 mb-6">
            Descripción del producto
          </h2>
          <div class="prose prose-lg max-w-3xl text-gray-700 leading-relaxed">
            {producto.descripcion.split("\n").filter((p: string) => p.trim()).map((parrafo: string) => (
              <p class="mb-4">{parrafo.trim()}</p>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Ficha técnica — full-width section -->
    {fichaHtml && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
        <div class={!producto.descripcion ? "border-t border-gray-200 pt-10" : ""}>
          <h2 class="font-display text-2xl font-bold text-gray-900 mb-6">
            Ficha técnica
          </h2>
          <div class="max-w-3xl">
            <div
              class="prose prose-base max-w-none text-gray-700 bg-gris-claro rounded-2xl p-6 sm:p-8 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1.5 [&_h3]:text-base [&_h3]:font-bold [&_h3]:text-gray-900 [&_h3]:mt-4 [&_h3]:first:mt-0 [&_blockquote]:border-l-3 [&_blockquote]:border-azul/40 [&_blockquote]:pl-4 [&_blockquote]:italic [&_img]:rounded-lg [&_img]:max-w-full [&_p]:mb-2"
              set:html={fichaHtml}
            />
          </div>
        </div>
      </section>
    )}

    <!-- Related products -->
    {relacionados.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
        <div class="border-t border-gray-200 pt-12">
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center">
            Productos relacionados
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
            {relacionados.map((p, i) => (
              <ProductCard producto={p} index={i} />
            ))}
          </div>
          <!-- Ver catálogo completo -->
          <div class="text-center mt-10">
            <a
              href="/catalogo"
              class="inline-flex items-center gap-2 bg-white border-2 border-azul text-azul px-6 py-3 rounded-xl text-sm font-semibold hover:bg-azul hover:text-white transition-all duration-200"
            >
              Ver catálogo completo
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </section>
    )}

    {relacionados.length === 0 && primarySub && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
        <div class="border-t border-gray-200 pt-12 text-center">
          <a
            href="/catalogo"
            class="inline-flex items-center gap-2 bg-white border-2 border-azul text-azul px-6 py-3 rounded-xl text-sm font-semibold hover:bg-azul hover:text-white transition-all duration-200"
          >
            Ver catálogo completo
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </section>
    )}
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
