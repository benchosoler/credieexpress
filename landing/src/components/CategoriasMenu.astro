---
import type { CategoriaNode } from "../lib/strapi-types";
import SubcategoriasList from "./SubcategoriasList.astro";

// Import placeholder SVGs (used when imagenRef is null or missing)
import electrodomesticosImg from "../assets/categorias/electrodomesticos.svg";
import hogarImg from "../assets/categorias/articulos-del-hogar.svg";
import gastronomicosImg from "../assets/categorias/articulos-gastronomicos.svg";

interface Props {
  categorias: CategoriaNode[];
  activeSubSlug?: string;
}

const { categorias, activeSubSlug } = Astro.props;

// Map category slug to its placeholder image
const PLACEHOLDER_MAP: Record<string, ImageMetadata> = {
  "electrodomesticos": electrodomesticosImg,
  "articulos-del-hogar": hogarImg,
  "articulos-gastronomicos": gastronomicosImg,
};

// Count active subcategorias per category
function activeSubCount(cat: CategoriaNode): number {
  if (!cat.subcategorias) return 0;
  return cat.subcategorias.filter(s => s.activo).length;
}
---

<div class="categorias-menu grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {categorias.map((cat) => {
    const subCount = activeSubCount(cat);
    const hasSubs = subCount > 0;
    const placeholder = PLACEHOLDER_MAP[cat.slug];

    return (
      <div
        class="categoria-tile bg-white rounded-2xl overflow-hidden card-shadow border border-gray-100 transition-all duration-300"
        data-categoria-slug={cat.slug}
      >
        {/* Category image */}
        <div class="relative aspect-[16/9] bg-gris-claro overflow-hidden cursor-pointer"
             data-action="toggle-category">
          {placeholder ? (
            <img
              src={placeholder.src}
              alt={cat.nombre}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
              loading="lazy"
              width={placeholder.width}
              height={placeholder.height}
            />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center gap-2 text-gray-300">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span class="text-xs font-medium">Sin imagen</span>
            </div>
          )}

          {/* Overlay with category name */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent flex items-end p-4">
            <div class="w-full">
              <h3 class="font-display font-bold text-white text-lg leading-tight">
                {cat.nombre}
              </h3>
              <p class="text-white/80 text-xs mt-1">
                {subCount} subcategoría{subCount !== 1 ? 's' : ''}
              </p>
            </div>
          </div>

          {/* Expand indicator */}
          {hasSubs && (
            <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/80 flex items-center justify-center transition-transform duration-300 categoria-chevron">
              <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          )}
        </div>

        {/* Expandable subcategories */}
        {hasSubs && (
          <div class="subcategorias-panel hidden border-t border-gray-100" data-panel={cat.slug}>
            <div class="p-4">
              <SubcategoriasList
                subcategorias={cat.subcategorias.filter(s => s.activo)}
                activeSlug={activeSubSlug}
              />
            </div>
          </div>
        )}
      </div>
    );
  })}
</div>

<script>
  // Single-open accordion: clicking a tile toggles its subcategories panel
  document.querySelectorAll<HTMLElement>('[data-action="toggle-category"]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const tile = trigger.closest<HTMLElement>('.categoria-tile');
      if (!tile) return;
      const slug = tile.dataset.categoriaSlug;
      if (!slug) return;
      const panel = document.querySelector<HTMLElement>(`[data-panel="${slug}"]`);
      if (!panel) return;
      const chevron = tile.querySelector<HTMLElement>('.categoria-chevron');

      const isCurrentlyOpen = !panel.classList.contains('hidden');

      // Close all panels
      document.querySelectorAll<HTMLElement>('.subcategorias-panel').forEach(p => p.classList.add('hidden'));
      document.querySelectorAll<HTMLElement>('.categoria-chevron').forEach(c => c.style.transform = '');

      if (!isCurrentlyOpen) {
        // Open this one
        panel.classList.remove('hidden');
        if (chevron) chevron.style.transform = 'rotate(180deg)';
      }
      // If it was already open, closing all panels above handles it
    });
  });
</script>
