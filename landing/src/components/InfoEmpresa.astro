<script>
  // Accordion behavior — vanilla JS, no hydration needed
  function togglePanel(trigger) {
    const targetId = trigger.dataset.target;
    const panel = document.getElementById(targetId);
    const chevron = trigger.querySelector(".accordion-chevron");
    const isOpen = !panel?.classList.contains("hidden");

    panel?.classList.toggle("hidden");
    chevron?.classList.toggle("rotate-180", !isOpen);
    trigger.setAttribute("aria-expanded", String(!isOpen));
  }

  function openPanelById(sectionId) {
    const trigger = document.querySelector(
      `.accordion-trigger[data-target="accordion-panel-${sectionId}"]`
    );
    const panel = document.getElementById(`accordion-panel-${sectionId}`);
    const chevron = trigger?.querySelector(".accordion-chevron");

    // Only open if currently closed
    if (panel?.classList.contains("hidden")) {
      panel.classList.remove("hidden");
      chevron?.classList.add("rotate-180");
      trigger?.setAttribute("aria-expanded", "true");
    }
  }

  function initAccordion() {
    const triggers = document.querySelectorAll(".accordion-trigger");

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => togglePanel(trigger));
    });

    // Auto-open section if URL hash matches an accordion item
    const hash = window.location.hash.replace("#", "");
    if (hash) {
      // Small delay so scroll lands first, then expand
      setTimeout(() => openPanelById(hash), 100);
    }

    // Listen for hash changes (e.g. clicking another navbar link)
    window.addEventListener("hashchange", () => {
      const newHash = window.location.hash.replace("#", "");
      if (newHash) openPanelById(newHash);
    });
  }

  document.addEventListener("DOMContentLoaded", initAccordion);
</script>
