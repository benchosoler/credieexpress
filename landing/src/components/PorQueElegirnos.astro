---
// Sección "Por qué elegirnos" — La más importante del sitio
// Destaca los valores diferenciadores reales del negocio
// con animaciones de entrada al hacer scroll

interface Feature {
  icon: string;
  title: string;
  description: string;
  accent: 'azul' | 'verde';
}

const features: Feature[] = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
    </svg>`,
    title: 'Cuotas 100% personalizadas',
    description:
      'Armamos el plan de cuotas según tu capacidad real de pago — semanales o diarias. No hay un plan fijo: nos adaptamos a vos.',
    accent: 'azul',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
    </svg>`,
    title: 'Trato cercano y personalizado',
    description:
      'No sos un número más. Cada cliente recibe atención directa, sin intermediarios, con respuestas rápidas y un vínculo de confianza.',
    accent: 'verde',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>`,
    title: 'Postventa real y seguimiento',
    description:
      'Después de la compra, te contactamos para saber si todo está bien. Si hay algún problema, te acompañamos a resolverlo.',
    accent: 'azul',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
    </svg>`,
    title: 'Servicio técnico rápido',
    description:
      'Trabajamos con técnicos de confianza que resuelven problemas en horas, no en semanas. Sin esperar al servicio oficial.',
    accent: 'verde',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
    </svg>`,
    title: 'Cambios y devoluciones',
    description:
      'Cuando es posible, gestionamos cambios y devoluciones. Queremos que estés satisfecho con tu compra, siempre.',
    accent: 'azul',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>`,
    title: '+10 años de experiencia',
    description:
      'Más de una década en el rubro nos da el conocimiento para asesorarte en lo que realmente necesita tu comercio.',
    accent: 'verde',
  },
];
---

<section id="por-que-elegirnos" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header de sección -->
    <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
      <!-- Etiqueta -->
      <span class="inline-block bg-azul/10 text-azul px-4 py-1.5 rounded-full text-sm font-semibold mb-4">
        Nuestra diferencia
      </span>

      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
        Por qué elegir
        <span class="text-gradient"> CREDIEXPRESS</span>
      </h2>
      <p class="text-lg text-gray-600">
        No somos una financiera más. Somos el aliado de tu comercio: te conocemos,
        te acompañamos y te ayudamos a crecer con equipamiento de calidad.
      </p>
    </div>

    <!-- Grilla de features -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, i) => (
        <article
          class="animate-on-scroll group bg-gris-claro hover:bg-white rounded-2xl p-7 transition-all duration-300 card-shadow border border-transparent hover:border-gray-200"
          style={`transition-delay: ${i * 80}ms`}
        >
          <!-- Ícono -->
          <div
            class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-5 transition-all duration-300 group-hover:scale-110 ${
              feature.accent === 'azul'
                ? 'bg-azul/10 text-azul group-hover:bg-azul group-hover:text-white'
                : 'bg-verde/10 text-verde group-hover:bg-verde group-hover:text-white'
            }`}
            set:html={feature.icon}
          />

          <!-- Contenido -->
          <h3 class="font-display font-bold text-xl text-gray-900 mb-2">
            {feature.title}
          </h3>
          <p class="text-gray-600 leading-relaxed text-sm">
            {feature.description}
          </p>
        </article>
      ))}
    </div>

    <!-- Banner de refuerzo -->
    <div class="mt-16 animate-on-scroll">
      <div class="gradient-brand rounded-3xl p-8 sm:p-12 text-white text-center relative overflow-hidden">
        <!-- Decoración fondo -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
          <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10"></div>
          <div class="absolute -bottom-16 -left-16 w-64 h-64 rounded-full bg-white/10"></div>
        </div>

        <div class="relative">
          <h3 class="font-display text-3xl sm:text-4xl font-bold mb-3">
            Tu comercio merece lo mejor
          </h3>
          <p class="text-white/85 text-lg mb-6 max-w-xl mx-auto">
            Consultanos hoy y te armamos un plan de cuotas sin compromiso.
          </p>
          <a
            href={`https://wa.me/5491164665339?text=${encodeURIComponent('Hola! Quiero consultar sobre productos y financiación.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-white text-azul px-8 py-3.5 rounded-2xl font-bold hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200"
          >
            <svg class="w-5 h-5 text-verde" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Hablar con un asesor
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
