---
// Navbar para página de catálogo — Links a otras páginas, no anchors
import Logo from "./Logo.astro";

const WA_NUMBER = "5491164665339";
const WA_MSG = encodeURIComponent(
  "Hola! Me interesa consultar sobre sus productos y financiación.",
);
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${WA_MSG}`;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/catalogo", label: "Catálogo", active: true },
  { href: "/#contacto", label: "Contacto" },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div
    class="absolute inset-0 bg-white/90 backdrop-blur-md border-b border-gray-100 transition-opacity duration-300"
    id="navbar-bg"
    style="opacity: 0;"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <Logo size="sm" />

      <nav
        class="hidden md:flex items-center gap-8"
        aria-label="Menú principal"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`font-medium text-sm transition-colors duration-200 relative group ${
                link.active
                  ? "text-azul font-semibold"
                  : "text-gray-600 hover:text-azul"
              }`}
            >
              {link.label}
              {!link.active && (
                <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-azul transition-all duration-300 group-hover:w-full" />
              )}
            </a>
          ))
        }
      </nav>

      <a
        href={WA_LINK}
        target="_blank"
        rel="noopener noreferrer"
        id="navbar-wa-btn"
        class="hidden md:flex items-center gap-2 bg-verde text-white px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-verde-dark transition-all duration-200 hover:shadow-lg hover:shadow-verde/30 hover:-translate-y-0.5"
      >
        <svg
          class="w-4 h-4 flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
        WhatsApp
      </a>

      <button
        id="menu-btn-catalogo"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:text-azul hover:bg-azul/10 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu-catalogo"
      >
        <svg
          id="icon-open-catalogo"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close-catalogo"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu-catalogo"
    class="md:hidden hidden bg-white border-t border-gray-100 shadow-lg"
    role="dialog"
    aria-label="Menú de navegación mobile"
  >
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-4 py-3 rounded-xl font-medium transition-colors mobile-nav-link-catalogo ${
              link.active
                ? "bg-azul/10 text-azul"
                : "text-gray-700 hover:text-azul hover:bg-azul/5"
            }`}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={WA_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 flex items-center justify-center gap-2 bg-verde text-white px-5 py-3 rounded-full font-semibold hover:bg-verde-dark transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
        Consultar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const navbarBg = document.getElementById("navbar-bg");
  window.addEventListener(
    "scroll",
    () => {
      const scrolled = window.scrollY > 20;
      if (navbarBg) navbarBg.style.opacity = scrolled ? "1" : "0";
    },
    { passive: true },
  );

  const menuBtn = document.getElementById("menu-btn-catalogo");
  const mobileMenu = document.getElementById("mobile-menu-catalogo");
  const iconOpen = document.getElementById("icon-open-catalogo");
  const iconClose = document.getElementById("icon-close-catalogo");

  menuBtn?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("hidden");
    mobileMenu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    menuBtn.setAttribute("aria-expanded", String(!isOpen));
  });

  document.querySelectorAll(".mobile-nav-link-catalogo").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
    });
  });
</script>
