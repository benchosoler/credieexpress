---
// Sección "Cómo funciona" — 3 pasos simples
// Diseño de timeline horizontal con números grandes y conectores
const steps = [
  {
    number: "01",
    title: "Elegís el producto",
    description:
      "Explorá nuestro catálogo de equipamiento para comercios y encontrá lo que necesitás: balanzas, heladeras, freezers, estanterías y más.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>`,
  },
  {
    number: "02",
    title: "Armamos tu plan",
    description:
      "Según tu capacidad de pago, diseñamos juntos el plan de cuotas ideal — semanales o diarias — sin letras chicas ni sorpresas.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
    </svg>`,
  },
  {
    number: "03",
    title: "Recibís y listo",
    description:
      "Coordinamos la entrega y te acompañamos post-compra. Si hay algún problema, el servicio técnico actúa rápido. Simple y sin vueltas.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    </svg>`,
  },
];
---

<section id="como-funciona" class="py-24 bg-gris-claro">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 animate-on-scroll">
      <span
        class="inline-block bg-verde/10 text-verde px-4 py-1.5 rounded-full text-sm font-semibold mb-4"
      >
        Proceso simple
      </span>
      <h2
        class="font-display text-4xl sm:text-5xl font-bold text-gray-900 mb-4"
      >
        ¿Cómo funciona?
      </h2>
      <p class="text-lg text-gray-600">
        En tres pasos simples, podés tener el equipamiento que tu comercio
        necesita.
      </p>
    </div>

    <!-- Pasos -->
    <div class="grid md:grid-cols-3 gap-8 relative">
      <!-- Línea conectora (desktop) -->
      <div
        class="hidden md:block absolute top-16 left-[calc(16.66%+2rem)] right-[calc(16.66%+2rem)] h-0.5 bg-gradient-to-r from-azul via-azul/50 to-verde"
        aria-hidden="true"
      >
      </div>

      {
        steps.map((step, i) => (
          <div
            class="animate-on-scroll relative flex flex-col items-center text-center"
            style={`transition-delay: ${i * 120}ms`}
          >
            {/* <!-- Número grande de fondo --> */}
            <div
              class="absolute -top-6 text-8xl font-display font-black text-gray-100 select-none pointer-events-none"
              aria-hidden="true"
            >
              {step.number}
            </div>

            {/* <!-- Ícono circular --> */}
            <div
              class={`relative z-10 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 shadow-lg ${
                i === 0
                  ? "bg-azul text-white"
                  : i === 1
                    ? "bg-gradient-to-br from-azul to-verde text-white"
                    : "bg-verde text-white"
              }`}
            >
              <Fragment set:html={step.icon} />
            </div>

            {/* <!-- Texto --> */}
            <h3 class="font-display font-bold text-xl text-gray-900 mb-3">
              {step.title}
            </h3>
            <p class="text-gray-600 leading-relaxed text-sm max-w-xs">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>

    <!-- CTA final -->
    <div class="mt-16 text-center animate-on-scroll">
      <p class="text-gray-500 mb-4 text-sm">¿Listo para empezar?</p>
      <a
        href="#catalogo"
        id="como-funciona-catalogo-btn"
        class="inline-flex items-center gap-2 bg-azul text-white px-8 py-4 rounded-2xl font-semibold hover:bg-azul-dark transition-all duration-200 hover:shadow-xl hover:shadow-azul/30 hover:-translate-y-0.5"
      >
        Ver productos disponibles
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
