---
// Sección de Contacto — WhatsApp directo, sin formulario
// Simple, directo y efectivo
const WA_NUMBER = '5491164665339';
const WA_NUMBER_DISPLAY = '11-6466-5339';
const WA_MSG = encodeURIComponent('Hola! Me gustaría recibir más información sobre sus productos y opciones de financiación.');
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${WA_MSG}`;
---

<section id="contacto" class="py-24 bg-gris-claro">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="animate-on-scroll bg-white rounded-3xl p-8 sm:p-14 text-center card-shadow border border-gray-100">

      <!-- Ícono WhatsApp grande -->
      <div class="w-20 h-20 bg-verde/10 rounded-3xl flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-verde" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </div>

      <!-- Título -->
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
        Hablemos hoy
      </h2>

      <!-- Descripción -->
      <p class="text-lg text-gray-600 max-w-xl mx-auto mb-4">
        Contanos qué necesitás para tu comercio y te armamos un plan de cuotas
        adaptado a tu realidad. Sin vueltas, sin letras chicas.
      </p>

      <!-- Número visible -->
      <a
        href={WA_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-verde font-display font-bold text-3xl sm:text-4xl hover:text-verde-dark transition-colors mb-8"
        aria-label={`Llamar o escribir al ${WA_NUMBER_DISPLAY}`}
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        {WA_NUMBER_DISPLAY}
      </a>

      <!-- Botón principal -->
      <div>
        <a
          href={WA_LINK}
          target="_blank"
          rel="noopener noreferrer"
          id="contacto-wa-btn"
          class="inline-flex items-center gap-3 bg-verde text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-verde-dark transition-all duration-200 hover:shadow-xl hover:shadow-verde/30 hover:-translate-y-0.5"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escribirnos por WhatsApp
        </a>
      </div>

      <!-- Horario / aclaración -->
      <p class="mt-6 text-sm text-gray-400">
        Respondemos a la brevedad • Lunes a Sábado
      </p>

    </div>
  </div>
</section>
