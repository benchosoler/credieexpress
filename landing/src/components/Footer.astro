---
// Footer — Logo, links, WhatsApp y frase del negocio
import Logo from './Logo.astro';

const WA_NUMBER = '5491164665339';
const WA_NUMBER_DISPLAY = '11-6466-5339';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Hola! Me interesa consultar sobre sus productos.')}`;

const navLinks = [
  { href: '#por-que-elegirnos', label: 'Por qué elegirnos' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#catalogo', label: 'Catálogo' },
  { href: '#contacto', label: 'Contacto' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white">
  <!-- Cuerpo del footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Columna 1: Logo + descripción -->
      <div class="lg:col-span-2">
        <!-- Logo en versión oscura -->
        <Logo size="md" dark={true} />

        <p class="mt-4 text-gray-400 text-sm leading-relaxed max-w-sm">
          Más de 10 años equipando comercios con balanzas, heladeras, freezers,
          estanterías y más. Financiación flexible adaptada a vos.
        </p>

        <!-- Frase del negocio -->
        <p class="mt-4 text-verde font-semibold text-sm italic">
          "Tu comercio crece, nosotros te acompañamos."
        </p>
      </div>

      <!-- Columna 2: Links de navegación -->
      <div>
        <h4 class="font-display font-bold text-white mb-4 text-sm uppercase tracking-wider">
          Navegación
        </h4>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-400 hover:text-white text-sm transition-colors duration-200 hover:translate-x-1 inline-block"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Contacto directo -->
      <div>
        <h4 class="font-display font-bold text-white mb-4 text-sm uppercase tracking-wider">
          Contacto
        </h4>
        <div class="space-y-3">
          <!-- WhatsApp -->
          <a
            href={WA_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 group"
            aria-label="Contactar por WhatsApp"
          >
            <div class="w-9 h-9 bg-verde/20 group-hover:bg-verde rounded-xl flex items-center justify-center flex-shrink-0 transition-colors duration-200">
              <svg class="w-4 h-4 text-verde group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <div class="text-white text-sm font-semibold group-hover:text-verde transition-colors">
                {WA_NUMBER_DISPLAY}
              </div>
              <div class="text-gray-500 text-xs">WhatsApp</div>
            </div>
          </a>

          <!-- Horario -->
          <div class="flex items-start gap-3">
            <div class="w-9 h-9 bg-azul/20 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-azul" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-white text-sm font-semibold">Lunes a Sábado</div>
              <div class="text-gray-500 text-xs">Atención comercial</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Línea de copyright -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-gray-500 text-xs">
        © {currentYear} CREDIEXPRESS - PAGO DIARIO. Todos los derechos reservados.
      </p>
      <p class="text-gray-600 text-xs">
        Financiación flexible para tu comercio
      </p>
    </div>
  </div>
</footer>
