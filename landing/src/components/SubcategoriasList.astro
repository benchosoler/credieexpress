---
import type { SubcategoriaNode } from "../lib/strapi-types";

interface Props {
  subcategorias: SubcategoriaNode[];
  /**
   * Slug de la categoría padre — se usa para construir el link de
   * "Ver todas" y como context de accesibilidad.
   */
  parentSlug?: string;
  /**
   * Link base para cada subcategoría. Default: "/catalogo".
   * Se le agrega `?subcategoria={slug}`.
   */
  linkBase?: string;
  /**
   * Máximo de subcategorías a mostrar antes de colapsar en "Ver más".
   * Default: 5
   */
  maxVisible?: number;
  /**
   * Slug de la subcategoría actualmente activa (resaltado en la lista).
   */
  activeSlug?: string;
}

const {
  subcategorias,
  parentSlug,
  linkBase = "/catalogo",
  maxVisible = 5,
  activeSlug,
} = Astro.props;

if (!subcategorias || subcategorias.length === 0) {
  return new Response(null, { status: 200 });
}

// Paleta de acento por subcategoría (determinístico por slug)
const DOT_PALETTE = [
  "bg-azul",
  "bg-verde",
  "bg-turquesa",
  "bg-cyan",
  "bg-azul-dark",
  "bg-verde-dark",
] as const;

const TEXT_PALETTE = [
  "text-azul",
  "text-verde",
  "text-turquesa",
  "text-cyan",
  "text-azul-dark",
  "text-verde-dark",
] as const;

const BG_HOVER_PALETTE = [
  "hover:bg-azul/5 hover:border-azul/40",
  "hover:bg-verde/5 hover:border-verde/40",
  "hover:bg-turquesa/5 hover:border-turquesa/40",
  "hover:bg-cyan/5 hover:border-cyan/40",
  "hover:bg-azul/5 hover:border-azul/40",
  "hover:bg-verde/5 hover:border-verde/40",
] as const;

function pickIdx(slug: string) {
  let h = 0;
  for (let i = 0; i < slug.length; i++) {
    h = (h * 31 + slug.charCodeAt(i)) | 0;
  }
  return Math.abs(h) % DOT_PALETTE.length;
}

// ─── Íconos SVG por subcategoría (determinístico por slug) ───
// Cada ícono es un SVG inline de 16x16 diseñado para ser semántico.
const SUBCAT_ICONS: Record<string, string> = {
  heladeras: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="4"/><path d="M8 2v20"/><line x1="16" y1="9" x2="16" y2="13"/><line x1="14" y1="11" x2="18" y2="11"/></svg>`,
  freezers: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="4"/><path d="M8 2v20"/><line x1="12" y1="9" x2="12" y2="13"/></svg>`,
  balanzas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 6h18M12 6v14"/><circle cx="12" cy="20" r="2"/><path d="M8 6l4-4 4 4"/><path d="M6 12h2l1 4h6l1-4h2"/></svg>`,
  estanterias: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="3"/></svg>`,
  gondolas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="7" y1="4" x2="7" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/><line x1="17" y1="4" x2="17" y2="20"/><line x1="2" y1="12" x2="22" y2="12"/></svg>`,
  exhibidores: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="5" x2="8" y2="19"/></svg>`,
  vitrinas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="18" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="12" y1="3" x2="12" y2="21"/></svg>`,
  cocinas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2H4V5z"/><rect x="4" y="7" width="16" height="13" rx="2"/><circle cx="8" cy="13" r="1.5"/><circle cx="16" cy="13" r="1.5"/><line x1="8" y1="17" x2="8" y2="18.5"/></svg>`,
  hornos: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="16" rx="3"/><line x1="9" y1="19" x2="9" y2="21"/><line x1="15" y1="19" x2="15" y2="21"/><line x1="4" y1="11" x2="20" y2="11"/><rect x="8" y="6" width="8" height="5" rx="0.5"/></svg>`,
  anafes: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="3"/><circle cx="8" cy="12" r="2.5"/><circle cx="16" cy="12" r="2.5"/><line x1="2" y1="9" x2="22" y2="9"/></svg>`,
  licuadoras: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="4" rx="1"/><path d="M6 6l2 16h8l2-16"/><rect x="10" y="18" width="4" height="2" rx="0.5"/></svg>`,
  batidoras: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M8 2h8l-2 14h-4z"/><circle cx="10" cy="19" r="1.5"/><circle cx="14" cy="19" r="1.5"/></svg>`,
  procesadoras: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="7" rx="2"/><path d="M7 9h10l-1 13H8z"/><line x1="12" y1="15" x2="12" y2="18"/></svg>`,
  cortadoras: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="9" r="7"/><line x1="12" y1="2" x2="12" y2="4"/><rect x="9" y="16" width="6" height="6" rx="1"/><line x1="12" y1="16" x2="12" y2="22"/></svg>`,
  termotanques: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><ellipse cx="12" cy="8" rx="8" ry="4"/><path d="M4 8v8c0 2.21 3.58 4 8 4s8-1.79 8-4V8"/><line x1="12" y1="12" x2="12" y2="14"/></svg>`,
  calefactores: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 6h12v14H6z"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="10" y1="8" x2="10" y2="16"/><line x1="12" y1="6" x2="12" y2="18"/><line x1="14" y1="8" x2="14" y2="16"/><line x1="16" y1="10" x2="16" y2="14"/></svg>`,
  ventiladores: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><circle cx="12" cy="12" r="8"/><path d="M12 4c0 0 2-2 4 0s0 4-4 4M12 20c0 0 2 2 4 0s0-4-4-4M4 12c0 0-2 2 0 4s4 0 4-4M20 12c0 0 2 2 0 4s-4 0-4-4"/></svg>`,
  aires: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><line x1="12" y1="4" x2="12" y2="16"/><line x1="8" y1="8" x2="8" y2="12"/><line x1="10" y1="8" x2="10" y2="12"/></svg>`,
  lavarropas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="4"/><circle cx="12" cy="11" r="4"/><circle cx="12" cy="11" r="1"/></svg>`,
  secarropas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="4"/><circle cx="12" cy="11" r="4"/><path d="M14 15l3 3"/></svg>`,
  microondas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><rect x="7" y="9" width="10" height="6" rx="0.5"/><line x1="8" y1="12" x2="16" y2="12"/></svg>`,
  tv: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 20h8"/><line x1="12" y1="18" x2="12" y2="20"/></svg>`,
  televisores: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 20h8"/><line x1="12" y1="18" x2="12" y2="20"/></svg>`,
  bazar: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  vajilla: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>`,
  ollas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 3h6v3H9z"/><path d="M7 6h10v12a3 3 0 01-3 3h-4a3 3 0 01-3-3V6z"/><line x1="4" y1="10" x2="4" y2="8"/><line x1="20" y1="10" x2="20" y2="8"/></svg>`,
  sartenes: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="18" y1="6" x2="6" y2="6"/><path d="M16 2l4 4-2 2-4-4 2-2z"/></svg>`,
  cafeteras: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="7" rx="2"/><path d="M9 4V2h6v2"/><path d="M14 11c0 1.66-1.34 3-3 3s-3-1.34-3-3"/><rect x="8" y="14" width="8" height="6" rx="1"/><line x1="8" y1="17" x2="16" y2="17"/></svg>`,
  mesas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="3" rx="0.5"/><line x1="6" y1="11" x2="6" y2="21"/><line x1="10" y1="11" x2="10" y2="21"/><line x1="14" y1="11" x2="14" y2="21"/><line x1="18" y1="11" x2="18" y2="21"/></svg>`,
  sillas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="4" rx="1"/><path d="M7 6l1.5 14h7L17 6"/><line x1="8" y1="17" x2="8" y2="21"/><line x1="16" y1="17" x2="16" y2="21"/></svg>`,
  herramientas: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
};

// Fallback: ícono genérico cuando el slug no coincide con ningún mapeo
const DEFAULT_ICON = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`;

function getSubcatIcon(slug: string): string {
  // Intentar match exacto
  if (SUBCAT_ICONS[slug]) return SUBCAT_ICONS[slug];
  // Intentar match parcial (ej: "freezer-vertical" => busca "freezer")
  const parts = slug.split("-");
  for (const part of parts) {
    if (SUBCAT_ICONS[part]) return SUBCAT_ICONS[part];
  }
  return DEFAULT_ICON;
}

const visible = subcategorias.slice(0, maxVisible);
const hidden = subcategorias.slice(maxVisible);
const hasMore = hidden.length > 0;
---

<ul class="subcategorias-list flex flex-col gap-1.5">
  {
    visible.map((sub) => {
      const idx = pickIdx(sub.slug);
      const hover = BG_HOVER_PALETTE[idx];
      const text = TEXT_PALETTE[idx];
      const isActive = activeSlug === sub.slug;
      const href = `${linkBase}?subcategoria=${sub.slug}`;
      const iconSvg = getSubcatIcon(sub.slug);

      return (
        <li>
          <a
            href={href}
            data-subcategoria-slug={sub.slug}
            data-subcategoria-name={sub.nombre}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "subcategoria-row group/row flex items-center gap-3 px-3.5 py-2.5 rounded-xl border border-transparent text-sm font-semibold transition-all duration-200",
              isActive
                ? "bg-azul/10 text-azul border-azul/30"
                : `text-gray-700 ${hover}`,
            ]}
          >
            <span
              class:list={[
                "w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 transition-colors duration-200",
                isActive
                  ? "bg-azul/20"
                  : "bg-gray-100 group-hover/row:bg-gray-200",
              ]}
              set:html={iconSvg}
              aria-hidden="true"
            />
            <span class="flex-1 truncate">{sub.nombre}</span>
            <svg
              class="w-3.5 h-3.5 text-gray-400 group-hover/row:translate-x-0.5 transition-transform duration-200"
              class:list={[isActive ? text : ""]}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </li>
      );
    })
  }
  {
    hasMore && (
      <li>
        <a
          href={parentSlug ? `${linkBase}?categoria=${parentSlug}` : linkBase}
          class="subcategoria-row flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-azul hover:bg-azul/5 transition-colors duration-200"
        >
          <span>Ver las {hidden.length} restantes</span>
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M13 7l5 5m0 0l-5 5m5-5H6"
            />
          </svg>
        </a>
      </li>
    )
  }
</ul>
