---
// Navbar — Logo + navegación + botón "Ver catálogo" destacado
// Usa vanilla JS para el menú mobile (sin hidratación innecesaria)
import Logo from "./Logo.astro";

const navLinks = [
  { href: "#por-que-elegirnos", label: "Por qué elegirnos" },
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <!-- Fondo con blur que aparece al hacer scroll -->
  <div
    class="absolute inset-0 bg-white/90 backdrop-blur-md border-b border-gray-100 transition-opacity duration-300"
    id="navbar-bg"
    style="opacity: 0;"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <Logo size="sm" />

      <!-- Nav desktop -->
      <nav
        class="hidden md:flex items-center gap-8"
        aria-label="Menú principal"
      >
        {
          navLinks.map((link) => {
            const isExternalPage = link.href.startsWith("/");
            return (
              <a
                href={link.href}
                class={`text-gray-600 hover:text-azul font-medium text-sm transition-colors duration-200 relative group ${
                  isExternalPage ? "" : ""
                }`}
              >
                {link.label}
                {!isExternalPage && (
                  <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-azul transition-all duration-300 group-hover:w-full" />
                )}
              </a>
            );
          })
        }
      </nav>

      <!-- CTA Ver catálogo desktop -->
      <a
        href="/catalogo"
        id="navbar-catalogo-btn"
        class="hidden md:flex items-center gap-2 bg-azul text-white px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-azul-dark transition-all duration-200 hover:shadow-lg hover:shadow-azul/30 hover:-translate-y-0.5"
      >
        <!-- Ícono catálogo -->
        <svg
          class="w-4 h-4 flex-shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path
            d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
          ></path>
        </svg>
        Ver catálogo
      </a>

      <!-- Botón hamburguesa mobile -->
      <button
        id="menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:text-azul hover:bg-azul/10 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="icon-open"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú mobile -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-white border-t border-gray-100 shadow-lg"
    role="dialog"
    aria-label="Menú de navegación mobile"
  >
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-3 text-gray-700 hover:text-azul hover:bg-azul/5 rounded-xl font-medium transition-colors mobile-nav-link"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/catalogo"
        class="mt-3 flex items-center justify-center gap-2 bg-azul text-white px-5 py-3 rounded-full font-semibold hover:bg-azul-dark transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path
            d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
          ></path>
        </svg>
        Ver catálogo
      </a>
    </nav>
  </div>
</header>

<script>
  // Efecto de fondo del navbar al hacer scroll
  const navbarBg = document.getElementById("navbar-bg");
  window.addEventListener(
    "scroll",
    () => {
      const scrolled = window.scrollY > 20;
      if (navbarBg) navbarBg.style.opacity = scrolled ? "1" : "0";
    },
    { passive: true },
  );

  // Toggle menú mobile
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  menuBtn?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("hidden");
    mobileMenu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    menuBtn.setAttribute("aria-expanded", String(!isOpen));
  });

  // Cerrar menú al hacer click en un link
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
    });
  });
</script>
