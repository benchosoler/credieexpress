---
// Catálogo de Productos — Render estático + filtrado client-side URL-driven.
//
// IMPORTANTE: este sitio es SSG (Astro genera HTML estático en build).
// Los query params ?categoria=X&subcategoria=Y NO se procesan en build time —
// todos los requests a /catalogo sirven el mismo HTML. Por eso el filtrado
// se hace en el cliente leyendo window.location.search al cargar.
import config from '../strapi-config.json';
const STRAPI_URL = config.strapiUrl || 'http://localhost:1337';
const WA_NUMBER = '5491164665339';

import ProductCard from './ProductCard.astro';
import type { ProductoStrapi, CategoriaNode } from '../lib/strapi-types';

// ─── Fetch ────────────────────────────
let categorias: CategoriaNode[] = [];
let productos: ProductoStrapi[] = [];
let errorMessage: string | null = null;

try {
  const [catRes, prodRes] = await Promise.all([
    fetch(
      `${STRAPI_URL}/api/categorias?filters[activo][$eq]=true&populate=subcategorias&sort=orden:asc`,
      { headers: { 'Content-Type': 'application/json' } }
    ),
    fetch(
      `${STRAPI_URL}/api/productos?filters[activo][$eq]=true&populate[subcategorias]=true&populate[imagenes]=true&populate[imagen]=true&pagination[pageSize]=100&sort=nombre:asc`,
      { headers: { 'Content-Type': 'application/json' } }
    ),
  ]);

  if (!catRes.ok || !prodRes.ok) {
    throw new Error(`Error en las APIs: cat=${catRes.status} prod=${prodRes.status}`);
  }

  const [catJson, prodJson] = await Promise.all([
    catRes.json(),
    prodRes.json(),
  ]);

  categorias = catJson.data || [];
  productos = prodJson.data || [];
} catch (error) {
  console.warn('[Catálogo] No se pudo conectar a Strapi:', error);
  errorMessage = 'No se pudo cargar el catálogo en este momento. Por favor, consultanos por WhatsApp.';
}

// ─── Datos para el cliente ────────────────────────────
// Precomputamos un slug → categoría/subcategoría para que el JS solo tenga
// que mirar un mapa y no recorrer arrays.
const categoriasJson = JSON.stringify(
  categorias.map((c) => ({
    slug: c.slug,
    nombre: c.nombre,
    subslugs: (c.subcategorias ?? []).filter((s) => s.activo).map((s) => s.slug),
    subnombres: (c.subcategorias ?? []).filter((s) => s.activo).map((s) => s.nombre),
  }))
);
---

<section id="catalogo" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {errorMessage ? (
      <!-- Estado de error -->
      <div class="max-w-lg mx-auto">
        <div class="bg-red-50 border border-red-100 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-red-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-gray-900 text-lg mb-2">
            Catálogo no disponible
          </h3>
          <p class="text-gray-600 text-sm mb-6">{errorMessage}</p>
          <a
            href={`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Hola! Quiero ver los productos disponibles y sus precios.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-verde text-white px-6 py-3 rounded-xl font-semibold hover:bg-verde-dark transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Consultar productos
          </a>
        </div>
      </div>
    ) : productos.length === 0 ? (
      <!-- Sin productos aún -->
      <div class="max-w-lg mx-auto">
        <div class="bg-gris-claro rounded-2xl p-12 text-center">
          <div class="w-16 h-16 bg-azul/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-azul/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-gray-900 text-lg mb-2">
            Catálogo en preparación
          </h3>
          <p class="text-gray-500 text-sm">
            Estamos cargando los productos. Mientras tanto, consultanos por WhatsApp.
          </p>
        </div>
      </div>
    ) : (
      <div>
        {/* ─── Header de la grid ─── */}
        <div id="productos-grid-anchor" class="scroll-mt-24">
          <div class="flex items-end justify-between mb-6 flex-wrap gap-4">
            <div>
              <h2
                id="grid-title"
                class="font-display text-2xl sm:text-3xl font-bold text-gray-900"
              >
                Todos los productos
              </h2>
              <p class="text-sm text-gray-500 mt-1.5">
                Mostrando <strong class="text-gray-900" id="count-number">{productos.length}</strong> producto{productos.length !== 1 ? 's' : ''}
              </p>
            </div>
            <a
              id="clear-filter-btn"
              href="/catalogo"
              class="hidden items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-azul transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Limpiar filtro
            </a>
          </div>

          {/* ─── Filter bar: tabs de categorías + chips de subcategorías ─── */}
          {categorias.length > 0 && (
            <nav
              class="mb-8 bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden"
              aria-label="Filtrar por categoría o subcategoría"
            >
              {/* Tabs de categorías */}
              <div class="p-2 sm:p-3 bg-gradient-to-br from-gris-claro/50 to-blue-50/30">
                <div class="flex flex-wrap gap-1.5" id="cat-tabs">
                  <a
                    href="/catalogo"
                    data-cat-tab=""
                    class="cat-tab group flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200"
                  >
                    <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center text-white text-xs">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                      </svg>
                    </span>
                    Todos
                  </a>
                  {categorias.map((cat) => (
                    <a
                      href={`/catalogo?categoria=${cat.slug}`}
                      data-cat-tab={cat.slug}
                      data-cat-tab-nombre={cat.nombre}
                      class="cat-tab group flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200"
                    >
                      <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-azul to-cyan flex items-center justify-center text-white text-xs font-display font-bold">
                        {cat.nombre.charAt(0).toUpperCase()}
                      </span>
                      <span>{cat.nombre}</span>
                    </a>
                  ))}
                </div>
              </div>

              {/* Chips de subcategorías (animados, aparecen al activar una categoría) */}
              <div
                id="subcat-bar"
                class="hidden border-t border-gray-100 bg-white"
              >
                <div class="p-4 sm:px-5 sm:py-4 flex flex-wrap items-center gap-2">
                  <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">
                    Subcategoría:
                  </span>
                  <a
                    id="subcat-todas"
                    href="/catalogo"
                    class="subcat-chip"
                  >
                    Todas
                  </a>
                  <div id="subcat-chips" class="contents">
                    {/* populated by JS */}
                  </div>
                </div>
              </div>
            </nav>
          )}

          {/* Grid de productos */}
          <div
            id="productos-grid"
            class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-6"
            data-total-productos={productos.length}
          >
            {productos.map((prod, i) => (
              <ProductCard producto={prod} index={i} />
            ))}
          </div>

          {/* Empty state — se muestra vía JS cuando ningún producto matchea */}
          <div id="no-results" class="hidden text-center py-16 bg-gris-claro rounded-2xl">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
              </svg>
            </div>
            <h3 class="font-display font-bold text-gray-900 text-lg mb-2">
              No hay productos <span id="no-results-cat"></span>
            </h3>
            <p class="text-gray-500 text-sm mb-6 max-w-md mx-auto">
              Probá con otra subcategoría o consultanos por WhatsApp para ver opciones disponibles.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <a
                href="/catalogo"
                class="inline-flex items-center gap-1.5 bg-white text-gray-700 border border-gray-200 px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-gray-50 transition-colors"
              >
                Ver todos los productos
              </a>
              <a
                id="no-results-wa"
                href={`https://wa.me/${WA_NUMBER}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-verde text-white px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-verde-dark transition-colors"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                Consultar por WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  /* Tabs de categoría — estados activo/inactivo.
     JS togglea la clase `is-active` según query params. */
  .cat-tab {
    @apply text-gray-600 hover:text-gray-900 hover:bg-white/60;
  }
  .cat-tab.is-active {
    @apply bg-white text-azul shadow-sm ring-1 ring-gray-200;
  }
  .cat-tab.is-active > span:first-child {
    @apply ring-2 ring-azul/30;
  }

  /* Chips de subcategoría */
  .subcat-chip {
    @apply inline-flex items-center px-3.5 py-1.5 rounded-full text-sm font-semibold border transition-all duration-200;
    @apply bg-white text-gray-600 border-gray-200;
    @apply hover:border-azul hover:text-azul hover:bg-azul/5;
  }
  .subcat-chip.is-active {
    @apply bg-gradient-to-r from-azul to-cyan text-white border-transparent shadow-md shadow-azul/30;
  }
</style>

{!errorMessage && productos.length > 0 && (
  <script define:vars={{ categoriasJson }}>
    // ─── Datos inyectados desde el server ────────────────────────────
    const CATEGORIAS = JSON.parse(categoriasJson);
    // Mapa subSlug -> { catSlug, catIndex, subIndex } para resolver todo en O(1)
    const SUB_INDEX = {};
    CATEGORIAS.forEach((c, ci) => {
      c.subslugs.forEach((s, si) => {
        SUB_INDEX[s] = { catSlug: c.slug, catIndex: ci, subIndex: si };
      });
    });

    // ─── Elementos del DOM ────────────────────────────
    const grid = document.getElementById('productos-grid');
    const cards = grid ? Array.from(grid.querySelectorAll('.producto-card')) : [];
    const noResults = document.getElementById('no-results');
    const noResultsCat = document.getElementById('no-results-cat');
    const noResultsWa = document.getElementById('no-results-wa');
    const countNumber = document.getElementById('count-number');
    const gridTitle = document.getElementById('grid-title');
    const clearBtn = document.getElementById('clear-filter-btn');
    const subcatBar = document.getElementById('subcat-bar');
    const subcatChips = document.getElementById('subcat-chips');
    const subcatTodas = document.getElementById('subcat-todas');
    const catTabs = document.querySelectorAll('.cat-tab');

    // ─── Helpers ────────────────────────────
    function getFilters() {
      const params = new URLSearchParams(window.location.search);
      return {
        cat: params.get('categoria') || '',
        sub: params.get('subcategoria') || '',
      };
    }

    function getActiveCategoria(cat) {
      if (cat) return CATEGORIAS.find((c) => c.slug === cat) || null;
      return null;
    }

    function resolveActiveCategoriaSlug() {
      const { cat, sub } = getFilters();
      if (cat) return cat;
      if (sub && SUB_INDEX[sub]) return SUB_INDEX[sub].catSlug;
      return '';
    }

    function getActiveSubName(subSlug) {
      const idx = SUB_INDEX[subSlug];
      if (!idx) return null;
      return CATEGORIAS[idx.catIndex].subnombres[idx.subIndex] || null;
    }

    // ─── Estado activo → UI ────────────────────────────
    function renderFilterBar() {
      const { cat, sub } = getFilters();
      const activeCatSlug = resolveActiveCategoriaSlug();
      const activeCat = getActiveCategoria(activeCatSlug);

      // Tabs de categoría
      catTabs.forEach((tab) => {
        const tabCat = tab.dataset.catTab || '';
        const isActive = activeCatSlug === tabCat;
        tab.classList.toggle('is-active', isActive);
        if (isActive) tab.setAttribute('aria-current', 'page');
        else tab.removeAttribute('aria-current');
      });

      // Subcategorías — solo si hay categoría activa con subs
      if (activeCat && activeCat.subslugs.length > 0) {
        subcatBar.classList.remove('hidden');
        subcatChips.innerHTML = '';

        // "Todas" — limpia subcategoria manteniendo la categoría
        subcatTodas.href = `/catalogo?categoria=${activeCat.slug}`;
        subcatTodas.classList.toggle('is-active', !sub);

        activeCat.subslugs.forEach((subSlug) => {
          const a = document.createElement('a');
          a.href = `/catalogo?categoria=${activeCat.slug}&subcategoria=${subSlug}`;
          a.className = 'subcat-chip';
          a.textContent = getActiveSubName(subSlug) || subSlug;
          a.setAttribute('data-subcategoria-slug', subSlug);
          if (subSlug === sub) {
            a.classList.add('is-active');
            a.setAttribute('aria-current', 'page');
          }
          subcatChips.appendChild(a);
        });
      } else {
        subcatBar.classList.add('hidden');
      }
    }

    // ─── Filtrado de productos ────────────────────────────
    function applyFilter() {
      const { cat, sub } = getFilters();
      const activeCatSlug = resolveActiveCategoriaSlug();
      const activeCat = getActiveCategoria(activeCatSlug);

      // Subcategorías que matchean el filtro actual
      const matchingSubs = new Set();
      if (sub) {
        matchingSubs.add(sub);
      } else if (activeCat) {
        activeCat.subslugs.forEach((s) => matchingSubs.add(s));
      }

      // Filtrar cards
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardSubs = (card.dataset.subcategorias || '').split(' ').filter(Boolean);
        const legacyCat = card.dataset.categoriaLegacy || '';

        let matches;
        if (!cat && !sub) {
          matches = true;
        } else if (sub) {
          matches = cardSubs.includes(sub);
        } else if (cat) {
          matches = cardSubs.some((s) => matchingSubs.has(s)) || legacyCat === cat;
        }

        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });

      // Contador
      if (countNumber) countNumber.textContent = String(visibleCount);

      // Empty state
      if (noResults && grid) {
        noResults.classList.toggle('hidden', visibleCount > 0);
        grid.classList.toggle('hidden', visibleCount === 0);
        if (visibleCount === 0) {
          const subName = sub ? getActiveSubName(sub) : null;
          if (noResultsCat) {
            const label = subName
              ? `en "${subName}"`
              : activeCat
                ? `en "${activeCat.nombre}"`
                : '';
            noResultsCat.textContent = label;
          }
          if (noResultsWa) {
            const text = subName
              ? `Hola! No encontré productos en "${subName}". ¿Tienen opciones similares?`
              : activeCat
                ? `Hola! No encontré productos en la categoría ${activeCat.nombre}. ¿Tienen opciones similares?`
                : 'Hola! Quiero ver los productos disponibles.';
            noResultsWa.href = `https://wa.me/5491164665339?text=${encodeURIComponent(text)}`;
          }
        }
      }

      // Título dinámico
      if (gridTitle) {
        if (sub) {
          gridTitle.textContent = getActiveSubName(sub) || sub;
        } else if (activeCat) {
          gridTitle.textContent = activeCat.nombre;
        } else {
          gridTitle.textContent = 'Todos los productos';
        }
      }

      // Botón limpiar
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', !(cat || sub));
      }

      // Re-render del filter bar (active states)
      renderFilterBar();
    }

    // ─── Init ────────────────────────────
    function scrollToGrid() {
      const { cat, sub } = getFilters();
      if (cat || sub) {
        const anchor = document.getElementById('productos-grid-anchor');
        // scrollIntoView puede no existir en algunos browsers/tests — defensivo.
        if (anchor && typeof anchor.scrollIntoView === 'function') {
          requestAnimationFrame(() => {
            anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
      }
    }

    // Las pills y tabs son <a href> — el navegador navega. Solo necesitamos
    // re-aplicar el filtro cuando el usuario usa los botones atrás/adelante.
    window.addEventListener('popstate', applyFilter);

    applyFilter();
    scrollToGrid();
  </script>
)}
