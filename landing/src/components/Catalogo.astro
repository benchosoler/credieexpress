---
// Catálogo de Productos — Visual category menu + grid orchestrator
// Replaces the old button-row filter with CategoriasMenu + subcategory-driven grid.
// Self-fetcher: 3 parallel fetches at build time (SSG).
import config from '../strapi-config.json';
const STRAPI_URL = config.strapiUrl || 'http://localhost:1337';
const WA_NUMBER = '5491164665339';

import ProductCard from './ProductCard.astro';
import CategoriasMenu from './CategoriasMenu.astro';
import type { ProductoStrapi, CategoriaNode } from '../lib/strapi-types';

// ─── State ────────────────────────────
let categorias: CategoriaNode[] = [];
let productos: ProductoStrapi[] = [];
let errorMessage: string | null = null;

try {
  const [catRes, prodRes] = await Promise.all([
    fetch(
      `${STRAPI_URL}/api/categorias?filters[activo][$eq]=true&populate=subcategorias&sort=orden:asc`,
      { headers: { 'Content-Type': 'application/json' } }
    ),
    fetch(
      `${STRAPI_URL}/api/productos?filters[activo][$eq]=true&populate[subcategorias]=true&populate[imagenes]=true&populate[imagen]=true&pagination[pageSize]=100&sort=nombre:asc`,
      { headers: { 'Content-Type': 'application/json' } }
    ),
  ]);

  if (!catRes.ok || !prodRes.ok) {
    throw new Error(`Error en las APIs: cat=${catRes.status} prod=${prodRes.status}`);
  }

  const [catJson, prodJson] = await Promise.all([
    catRes.json(),
    prodRes.json(),
  ]);

  categorias = catJson.data || [];
  productos = prodJson.data || [];
} catch (error) {
  console.warn('[Catálogo] No se pudo conectar a Strapi:', error);
  errorMessage = 'No se pudo cargar el catálogo en este momento. Por favor, consultanos por WhatsApp.';
}
---

<section id="catalogo" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {errorMessage ? (
      <!-- Estado de error -->
      <div class="animate-on-scroll max-w-lg mx-auto">
        <div class="bg-red-50 border border-red-100 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-red-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-gray-900 text-lg mb-2">
            Catálogo no disponible
          </h3>
          <p class="text-gray-600 text-sm mb-6">{errorMessage}</p>
          <a
            href={`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Hola! Quiero ver los productos disponibles y sus precios.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-verde text-white px-6 py-3 rounded-xl font-semibold hover:bg-verde-dark transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Consultar productos
          </a>
        </div>
      </div>
    ) : productos.length === 0 ? (
      <!-- Sin productos aún -->
      <div class="animate-on-scroll max-w-lg mx-auto">
        <div class="bg-gris-claro rounded-2xl p-12 text-center">
          <div class="w-16 h-16 bg-azul/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-azul/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-gray-900 text-lg mb-2">
            Catálogo en preparación
          </h3>
          <p class="text-gray-500 text-sm">
            Estamos cargando los productos. Mientras tanto, consultanos por WhatsApp.
          </p>
        </div>
      </div>
    ) : (
      <!-- CATÁLOGO COMPLETO — NEW UI -->
      <div>
        {/* ─── 1. Category Menu with subcategories ─── */}
        {categorias.length > 0 && (
          <div class="animate-on-scroll mb-16" id="categoria-menu">
            <h3 class="font-display font-bold text-2xl text-gray-900 mb-6">
              Categorías
            </h3>
            <CategoriasMenu categorias={categorias} activeSubSlug="" />
          </div>
        )}

        {/* ─── 3. Product Grid with subcategory filter ─── */}
        <div class="animate-on-scroll" id="productos-grid-anchor">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <h3 class="font-display font-bold text-2xl text-gray-900">
              Todos los productos
            </h3>
            <div class="flex items-center gap-3">
              <span class="text-sm text-gray-400" id="productos-count">
                Mostrando <strong id="count-number">{productos.length}</strong> producto{productos.length !== 1 ? 's' : ''}
              </span>
              <button
                id="ver-todos-btn"
                class="hidden px-4 py-1.5 rounded-full text-xs font-semibold bg-gris-claro text-gray-500 hover:bg-azul/10 hover:text-azul transition-all"
                type="button"
              >
                Ver todos
              </button>
            </div>
          </div>

          {/* Active filter indicator */}
          <div id="active-filter-badge" class="hidden mb-4">
            <span class="inline-flex items-center gap-2 bg-azul/10 text-azul px-4 py-2 rounded-full text-sm font-semibold">
              <span id="active-filter-name"></span>
            </span>
          </div>

          <div id="productos-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {productos.map((prod, i) => (
              <ProductCard producto={prod} index={i} />
            ))}
          </div>

          <div id="no-results" class="hidden text-center py-16">
            <p class="text-gray-400 text-lg">No hay productos en esta categoría.</p>
          </div>
        </div>

      </div>
    )}

  </div>
</section>

{!errorMessage && productos.length > 0 && (
  <script>
    // Subcategory filtering via data-subcategorias attribute and
    // the 'subcategory-select' CustomEvent from CategoriasMenu/SubcategoriasList.

    // REQ-CH-3: warn about products with no subcategorias linked (legacy-only fallback)
    document
      .querySelectorAll<HTMLElement>('[data-subcategorias=""]')
      .forEach((card) => {
        console.warn(
          '[Catálogo] Producto sin subcategorías linkeadas (documentId):',
          card.dataset.documentId,
        );
      });

    let activeSubSlug: string | null = null;

    const grid = document.getElementById('productos-grid');
    const countNumber = document.getElementById('count-number');
    const noResults = document.getElementById('no-results');
    const verTodosBtn = document.getElementById('ver-todos-btn');
    const activeFilterBadge = document.getElementById('active-filter-badge');
    const activeFilterName = document.getElementById('active-filter-name');

    function applyFilter(slug: string | null) {
      activeSubSlug = slug;
      let visibleCount = 0;
      document.querySelectorAll<HTMLElement>('[data-subcategorias]').forEach((card) => {
        const subs = (card.dataset.subcategorias || '').split(' ').filter(Boolean);
        const matches = !slug || subs.includes(slug);
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });

      // Update count
      if (countNumber) {
        countNumber.textContent = String(visibleCount);
      }

      // Show/hide "no results"
      if (noResults && grid) {
        noResults.classList.toggle('hidden', visibleCount > 0);
        grid.classList.toggle('hidden', visibleCount === 0);
      }

      // Show/hide "Ver todos" button
      if (verTodosBtn) {
        verTodosBtn.classList.toggle('hidden', !slug);
      }

      // Show/hide active filter badge
      if (activeFilterBadge && activeFilterName) {
        if (slug) {
          activeFilterBadge.classList.remove('hidden');
          // Find the subcategoria name from the clicked button
          const btn = document.querySelector<HTMLElement>(`[data-subcategoria-slug="${slug}"]`);
          activeFilterName.textContent = btn?.dataset.subcategoriaName || slug;
        } else {
          activeFilterBadge.classList.add('hidden');
        }
      }

      // Scroll the products grid into view so the user sees the filtered
      // results without having to scroll down manually.
      if (slug) {
        const anchor = document.getElementById('productos-grid-anchor');
        if (anchor) {
          anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    // Listen for subcategory-select events from CategoriasMenu/SubcategoriasList
    window.addEventListener('subcategory-select', ((e: CustomEvent) => {
      const { slug } = e.detail || {};
      applyFilter(slug || null);
    }) as EventListener);

    // "Ver todos" button — reset filter
    verTodosBtn?.addEventListener('click', () => applyFilter(null));

    // ─── Pre-filter from URL ───
    // /catalogo?categoria=electrodomesticos → pre-filter to all subcategorias of that category
    // /catalogo?subcategoria=heladeras       → pre-filter to that specific subcategoria (wins over categoria)
    const params = new URLSearchParams(window.location.search);
    const subcategoriaSlug = params.get('subcategoria');
    const categoriaSlug = !subcategoriaSlug ? params.get('categoria') : null;

    if (subcategoriaSlug) {
      // Direct subcategoria pre-filter: reuse the existing single-slug filter
      const subBtn = document.querySelector<HTMLElement>(
        `[data-subcategoria-slug="${subcategoriaSlug}"]`,
      );
      if (subBtn) {
        const subNombre = subBtn.dataset.subcategoriaName || subcategoriaSlug;
        applyFilter(subcategoriaSlug);
        if (activeFilterBadge && activeFilterName) {
          activeFilterBadge.classList.remove('hidden');
          activeFilterName.textContent = subNombre;
        }
        // Expand the parent category tile so the user sees context
        const parentTile = subBtn.closest<HTMLElement>('.categoria-tile');
        const parentSlug = parentTile?.dataset.categoriaSlug;
        if (parentSlug) {
          const panel = document.querySelector<HTMLElement>(`[data-panel="${parentSlug}"]`);
          const chevron = parentTile?.querySelector<HTMLElement>('.categoria-chevron');
          if (panel) {
            document.querySelectorAll<HTMLElement>('.subcategorias-panel').forEach((p) => p.classList.add('hidden'));
            document.querySelectorAll<HTMLElement>('.categoria-chevron').forEach((c) => (c.style.transform = ''));
            panel.classList.remove('hidden');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          }
        }
      }
    } else if (categoriaSlug) {
      // Category pre-filter: show products that match ANY of the category's subcategorias
      const catTile = document.querySelector<HTMLElement>(
        `.categoria-tile[data-categoria-slug="${categoriaSlug}"]`,
      );
      if (catTile) {
        const catNombre = catTile.dataset.categoriaNombre || categoriaSlug;
        const subSlugs = Array.from(
          catTile.querySelectorAll<HTMLElement>('[data-subcategoria-slug]'),
        ).map((el) => el.dataset.subcategoriaSlug).filter(Boolean) as string[];

        if (subSlugs.length > 0) {
          activeSubSlug = '__category__';
          let visibleCount = 0;
          document.querySelectorAll<HTMLElement>('[data-subcategorias]').forEach((card) => {
            const cardSubs = (card.dataset.subcategorias || '').split(' ').filter(Boolean);
            const matches = cardSubs.some((s) => subSlugs.includes(s));
            card.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
          });
          if (countNumber) countNumber.textContent = String(visibleCount);
          if (noResults && grid) {
            noResults.classList.toggle('hidden', visibleCount > 0);
            grid.classList.toggle('hidden', visibleCount === 0);
          }
          if (verTodosBtn) verTodosBtn.classList.remove('hidden');
          if (activeFilterBadge && activeFilterName) {
            activeFilterBadge.classList.remove('hidden');
            activeFilterName.textContent = catNombre;
          }
        }
      }
    }
  </script>
)}
