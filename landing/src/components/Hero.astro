---
// Hero Section — Impacto visual inmediato
// Fondo con gradiente sutil, partículas decorativas y CTA doble
const WA_NUMBER = "5491164665339";
const WA_MSG = encodeURIComponent(
  "Hola! Quiero consultar sobre sus productos y planes de financiación.",
);
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${WA_MSG}`;
---

<section
  id="inicio"
  class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-white via-gris-claro to-blue-50 pt-20"
>
  <!-- Decoración de fondo — círculos difusos de color -->
  <div
    class="absolute inset-0 overflow-hidden pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-azul/8 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-20 w-[500px] h-[500px] rounded-full bg-verde/8 blur-3xl"
    >
    </div>
    <!-- Puntos decorativos -->
    <div class="absolute top-1/4 right-1/4 w-3 h-3 rounded-full bg-azul/30">
    </div>
    <div class="absolute top-1/3 right-1/3 w-2 h-2 rounded-full bg-verde/30">
    </div>
    <div class="absolute bottom-1/3 left-1/4 w-4 h-4 rounded-full bg-azul/20">
    </div>
  </div>

  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center"
  >
    <!-- Texto principal -->
    <div class="text-center lg:text-left">
      <!-- Chip de confianza -->
      <div
        class="inline-flex items-center gap-2 bg-azul/10 text-azul px-4 py-1.5 rounded-full text-sm font-semibold mb-6 animate-fade-in"
      >
        <span class="w-2 h-2 rounded-full bg-verde animate-pulse"></span>
        +10 años equipando comercios
      </div>

      <!-- Título impactante -->
      <h1
        class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight text-gray-900 mb-6"
      >
        Equipá tu<br />
        comercio
        <span class="block text-gradient mt-1">sin límites</span>
      </h1>

      <!-- Subtítulo -->
      <p
        class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-10 max-w-xl mx-auto lg:mx-0"
      >
        Balanzas, heladeras, freezers, estanterías y más — con planes de cuotas
        <strong class="text-gray-800"> semanales o diarias</strong> adaptados exactamente
        a tu capacidad de pago.
      </p>

      <!-- Botones CTA -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
      >
        <a
          href={WA_LINK}
          target="_blank"
          rel="noopener noreferrer"
          id="hero-wa-btn"
          class="inline-flex items-center justify-center gap-2 bg-verde text-white px-8 py-4 rounded-2xl font-semibold text-base hover:bg-verde-dark transition-all duration-200 hover:shadow-xl hover:shadow-verde/30 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          Consultá ahora
        </a>
        <a
          href="/catalogo"
          id="hero-catalogo-btn"
          class="inline-flex items-center justify-center gap-2 bg-white text-azul border-2 border-azul px-8 py-4 rounded-2xl font-semibold text-base hover:bg-azul hover:text-white transition-all duration-200 hover:shadow-xl hover:shadow-azul/30 hover:-translate-y-0.5"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path
              d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
            />
          </svg>
          Ver catálogo
        </a>
      </div>

      <!-- Stats de confianza -->
      <div class="mt-12 grid grid-cols-3 gap-4 max-w-md mx-auto lg:mx-0">
        <div class="text-center">
          <div class="text-2xl font-display font-bold text-azul">+10</div>
          <div class="text-xs text-gray-500 mt-0.5">años de experiencia</div>
        </div>
        <div class="text-center border-x border-gray-200">
          <div class="text-2xl font-display font-bold text-verde">100%</div>
          <div class="text-xs text-gray-500 mt-0.5">cuotas personalizadas</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-display font-bold text-azul">24hs</div>
          <div class="text-xs text-gray-500 mt-0.5">servicio técnico</div>
        </div>
      </div>
    </div>

    <!-- Panel visual derecho -->
    <div class="hidden lg:flex justify-center items-center">
      <div class="relative">
        <!-- Tarjeta decorativa principal -->
        <div class="bg-white rounded-3xl shadow-2xl p-8 w-80 card-shadow">
          <!-- Mini logo en la tarjeta -->
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 gradient-brand rounded-xl flex items-center justify-center"
            >
              <span class="text-white font-display font-bold text-sm">CE</span>
            </div>
            <div>
              <div class="font-bold text-gray-900 text-sm">
                Plan personalizado
              </div>
              <div class="text-xs text-verde font-semibold">● Activo</div>
            </div>
          </div>

          <!-- Producto de ejemplo -->
          <div class="bg-gris-claro rounded-2xl p-4 mb-4">
            <div class="text-xs text-gray-500 mb-1">Producto</div>
            <div class="font-semibold text-gray-900">
              Balanza digital comercial
            </div>
            <div class="text-azul font-bold mt-1">$ consultar precio</div>
          </div>

          <!-- Plan de cuotas -->
          <div class="space-y-2">
            <div
              class="text-xs text-gray-500 font-semibold uppercase tracking-wide"
            >
              Tu plan de cuotas
            </div>
            {
              [
                { label: "Cuotas semanales", tag: "✓", color: "text-verde" },
                { label: "Cuotas diarias", tag: "✓", color: "text-verde" },
                { label: "Pago personalizado", tag: "✓", color: "text-verde" },
              ].map((item) => (
                <div class="flex items-center justify-between py-1.5 border-b border-gray-100 last:border-0">
                  <span class="text-sm text-gray-700">{item.label}</span>
                  <span class={`font-bold ${item.color}`}>{item.tag}</span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Chip flotante decorativo -->
        <div
          class="absolute -top-4 -right-4 bg-verde text-white px-4 py-2 rounded-2xl text-sm font-bold shadow-lg shadow-verde/30 rotate-3"
        >
          Sin interés oculto
        </div>
        <div
          class="absolute -bottom-4 -left-4 bg-azul text-white px-4 py-2 rounded-2xl text-sm font-bold shadow-lg shadow-azul/30 -rotate-2"
        >
          Postventa real
        </div>
      </div>
    </div>
  </div>

  <!-- Flecha de scroll animada -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce"
    aria-hidden="true"
  >
    <a
      href="#por-que-elegirnos"
      class="text-gray-400 hover:text-azul transition-colors"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </a>
  </div>
</section>
