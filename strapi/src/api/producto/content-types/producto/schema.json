{
  "kind": "collectionType",
  "collectionName": "productos",
  "info": {
    "singularName": "producto",
    "pluralName": "productos",
    "displayName": "Producto",
    "description": "Catálogo de productos CrediExpress con financiación"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre"
    },
    "descripcion": {
      "type": "text"
    },
    "precio": {
      "type": "decimal",
      "min": 0
    },
    "categoria": {
      "type": "enumeration",
      "enum": [
        "Balanzas",
        "Heladeras",
        "Freezers",
        "Estanterías",
        "Cortadoras de fiambre",
        "Góndolas",
        "Accesorios",
        "Otros"
      ],
      "required": true,
      "description": "DEPRECATED — use subcategorias relation. Maintained for migration compatibility."
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files"],
      "description": "DEPRECATED — use imagenes (multiple). Fallback when imagenes is empty."
    },
    "subcategorias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::subcategoria.subcategoria",
      "inversedBy": "productos"
    },
    "imagenes": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "fichaTecnica": {
      "type": "richtext"
    },
    "destacado": {
      "type": "boolean",
      "default": false
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  }
}
